<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Search Results</title>
</head>
<body>
    <h1>Search Results for "<%- query %>"</h1>

    <% if (books.length === 0) { %>
        <p>No books found. Try a different search.</p>
    <% } else { %>
        <% books.forEach(book => { %>
            <div class="book-card">
                <% if (book.coverUrl) { %>
                    <img src="<%- book.coverUrl %>" alt="cover">
                <% } %>
                <div class="book-info">
                    <strong><%- book.title %></strong><br>
                    <em><%- book.author %></em><br><br>
                    <form action="/journal/save" method="post">
                        <input type="hidden" name="title" value="<%- book.title %>">
                        <input type="hidden" name="author" value="<%- book.author %>">
                        <input type="hidden" name="coverUrl" value="<%- book.coverUrl %>">
                        <input type="hidden" name="openLibraryId" value="<%- book.openLibraryId %>">
                        <label><strong>Rating (1-5): </strong><input type="number" name="rating" min="1" max="5"></label><br>
                        <label><strong>Notes: </strong><br><textarea name="notes" rows="3" cols="30"></textarea></label><br><br>
                        <input type="submit" value="Save to Journal">
                    </form>
                </div>
            </div>
            <hr>
        <% }) %>
    <% } %>

    <a href="/books/search">Search Again</a> | <a href="/">HOME</a>
</body>
</html>