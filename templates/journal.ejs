<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>My Journal</title>
</head>
<body>
    <h1>My Book Journal</h1>

    <% if (books.length === 0) { %>
        <p>No books saved yet. <a href="/books/search">Search for one!</a></p>
    <% } else { %>
        <% books.forEach(book => { %>
            <div class="book-card">
                <% if (book.coverUrl) { %>
                    <img src="<%- book.coverUrl %>" alt="cover">
                <% } %>
                <div class="book-info">
                    <strong><%- book.title %></strong><br>
                    <em><%- book.author %></em><br>
                    <strong>Rating: </strong> <%- book.rating %> / 5<br>
                    <strong>Notes: </strong> <%- book.notes %><br>
                    <strong>Saved: </strong> <%- book.dateAdded.toDateString() %><br><br>
                    <form action="/journal/delete/<%- book._id %>" method="post">
                        <input type="submit" value="Remove">
                    </form>
                </div>
            </div>
            <hr>
        <% }) %>
    <% } %>

    <a href="/">HOME</a>
</body>
</html>